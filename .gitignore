.vscode/
.idea/
*.user
*.suo
*.sln.docstates
*.xcuserstate
xcuserdata/

# OS noise
.DS_Store
Thumbs.db
desktop.ini

# Local tools (pluginval binaries etc. are never committed)
/10_BUILD/tools/
